{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build:reader": "node scripts/build-reader-bundle.mjs",
    "watch:reader": "node scripts/build-reader-bundle.mjs --watch",
    "postinstall": "node scripts/build-reader-bundle.mjs",
    "prestart": "npm run build:reader",
    "start": "expo start --dev-client",
    "preandroid": "npm run build:reader",
    "android": "expo run:android",
    "preios": "npm run build:reader",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy",
    "db:generate": "drizzle-kit generate",
    "pretypecheck": "npm run build:reader",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.2.4",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-orm": "^0.45.4",
    "expo": "^57.0.1",
    "expo-asset": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.2",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0"
  }
}
