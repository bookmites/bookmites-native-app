{
  "expo": {
    "name": "Bookmite Reader",
    "slug": "bookmite-reader",
    "scheme": "bookmite-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "org.bookmites.reader"
    },
    "ios": {
      "bundleIdentifier": "org.bookmites.reader"
    }
  }
}
